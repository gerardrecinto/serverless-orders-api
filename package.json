{
  "name": "serverless-orders-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orders API on AWS: Node.js and TypeScript Lambda behind API Gateway, SQS worker, DynamoDB, Terraform, CI.",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "dev": "node src/local.ts",
    "bench": "node scripts/bench.ts",
    "coverage": "node --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
